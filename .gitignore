###############################
# Operating System Files
.DS_Store             
**/.DS_Store
.localized
desktop.ini
Thumbs.db

# Jupyter Notebook Files
.ipynb_checkpoints/
*.ipynb_checkpoints
.ipynb_vendored/
.jupyter/

###############################
# Conda/Python Environment Files
*.pyc
__pycache__/          
venv/                
env/                 
.conda/               
.condarc              

# 1. Python3 compiled bytecode
__pycache__/
# 2. Virtual environment folder (if you use venv alongside conda)
venv/
# 3. Another common name for virtual environment folder
env/
# 4. Conda specific files (rarely needed to track)
.conda/
# 5. Conda configuration file (usually user-specific)
.condarc


###############################
# Jupyter Notebook Files
###############################

# 1. Jupyter auto-generated checkpoints
.ipynb_checkpoints/
# 2. Backup files created by Jupyter
*.ipynb_checkpoints
# 3. Jupyter vendored extensions
.ipynb_vendored/
# 4. Jupyter configuration directory (if not shared)
.jupyter/


###############################
# IDE and Editor Files
###############################
# 1. Visual Studio Code settings
.vscode/
# 2. IntelliJ/PyCharm settings
.idea/
# 3. Vim swap files
*.swp
# 4. Emacs backup files
*~


###############################
# Miscellaneous
###############################
# 1. Log files
*.log
# 2. Backup files
*.bak
# 3. Temporary files
*.tmp


###############################
# Data Files (Important: Only ignore processed/derived data, NOT raw data you want to track)
###############################

# Consider ignoring large output files or intermediate data that can be regenerated.
# For example, if your notebooks generate large CSVs or plots:
# output/             # Folder for generated output files
# *.csv               # If these are large, generated CSVs
# *.txt               # If these are large, generated TXT files
# *.zip
# *.tar.gz
# *.pkl               # Python pickle files (often large and not suitable for version control)
*.mp4
*.gif
*.

